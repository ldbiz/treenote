{
  "name": "treenote",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretauri": "node scripts/ensure-deps.mjs",
